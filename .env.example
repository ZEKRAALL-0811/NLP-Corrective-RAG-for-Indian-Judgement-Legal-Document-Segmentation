# ==============================================================================
# JurisGraph Environment Configuration Template
# Copy this file to .env and populate your personal API keys.
# DO NOT commit your actual .env file with real credentials!
# ==============================================================================

# Ollama Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Evaluation & Judge API Keys (Optional - only required for automated audit scripts)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# External Search Fallback (Optional - for web search fallback when enabled)
TAVILY_API_KEY=your_tavily_api_key_here
ENABLE_WEB_FALLBACK=true

# Quality Gate Settings
ENABLE_ONLINE_GATE=false
